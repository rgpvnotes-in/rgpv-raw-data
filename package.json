{
  "name": "rgpv-raw-data",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/rgpvnotes-in/rgpv-raw-data#readme",
  "bugs": {
    "url": "https://github.com/rgpvnotes-in/rgpv-raw-data/issues"
  },
  "license": "ISC",
  "author": "Aditya Jain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgpvnotes-in/rgpv-raw-data.git"
  },
  "type": "module",
  "main": "get_timetable_data.ts",
  "scripts": {
    "compile:timetable": "tsx get_timetable_data.ts",
    "compile:syllabus": "tsx get_syllabus_data.ts",
    "compile:scheme": "tsx get_scheme_data.ts",
    "compile:info": "tsx get_info_data.ts",
    "compile:news": "tsx write_news_alerts.ts",
    "build:data": "pnpm run compile:timetable && pnpm run compile:syllabus && pnpm run compile:scheme && pnpm run compile:info",
    "build": "pnpm run build:data",
    "bundle": "vp pack",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint .",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "prepare": "vp config"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "puppeteer": "^25.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.1"
}
